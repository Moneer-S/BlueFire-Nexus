<!--
  Sysmon for Linux configuration used by the lab.
  An empty "exclude" filter records every event of that type.
  Process environments are not recorded: Sysmon has no such field.
-->
<Sysmon schemaversion="4.81">
  <EventFiltering>
    <ProcessCreate onmatch="exclude"/>
    <NetworkConnect onmatch="exclude"/>
    <ProcessTerminate onmatch="exclude"/>
    <FileCreate onmatch="exclude"/>
    <FileDelete onmatch="exclude"/>
  </EventFiltering>
</Sysmon>
