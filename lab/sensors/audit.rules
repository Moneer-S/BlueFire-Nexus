## auditd rules for the lab target, loaded by "bluefire-lab run --audit-rules",
## which fills in the home folder of the account the tests run as.
##
## Sysmon for Linux reports a write to a file only when it leaves the file
## looking newly created, so an append to a file that already exists, such as a
## command added to ~/.bashrc, leaves nothing in its output. The watches below
## record writes, and changes of permissions, owner and extended attributes
## (not chattr's file flags), to the files that run code when an account logs
## in or starts a shell. Programs also report some actions themselves, such as
## useradd adding an account or sudo running a command.
##
## Process starts are recorded too, with their arguments (EXECVE records), as
## the pinned SigmaHQ auditd rules that look at commands need. Only processes
## with a login uid are recorded: the lab sets one at the start of every step,
## and the runner's own processes have none.

## Start from no rules, and keep a backlog large enough for a burst.
-D
-b 32768

## The file the lab writes until auditd has recorded the write.
-w /var/tmp/bluefire-lab-audit-probe -p wa -k bluefire-lab-probe

## Shell start files of every account, and of root and of the test account.
-w /etc/profile -p wa -k shell-start
-w /etc/profile.d -p wa -k shell-start
-w /etc/bash.bashrc -p wa -k shell-start
-w /etc/environment -p wa -k shell-start
-w /root/.bashrc -p wa -k shell-start
-w /root/.profile -p wa -k shell-start
-w {home}/.bashrc -p wa -k shell-start
-w {home}/.profile -p wa -k shell-start
-w {home}/.bash_profile -p wa -k shell-start
-w {home}/.bash_login -p wa -k shell-start
-w {home}/.bash_logout -p wa -k shell-start

## Process starts in the lab's steps.
-a always,exit -F arch=b64 -S execve -F auid!=unset -k process-start
-a always,exit -F arch=b32 -S execve -F auid!=unset -k process-start
